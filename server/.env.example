# Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-vault-key-min-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Optional: PostgreSQL Connection (Leave blank for in-memory dev mode, or provide Neon/Supabase/local URL)
# Example: postgresql://postgres:password@localhost:5432/mood_vault
DATABASE_URL=

# Optional: Redis Connection (Leave blank for in-memory token bucket rate limiter, or provide Upstash/local URL)
# Example: redis://localhost:6379
REDIS_URL=

# Rate Limiter Thresholds
RATE_LIMIT_MAX=100
